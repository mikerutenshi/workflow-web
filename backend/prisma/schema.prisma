// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MEN
  WOMEN
  KIDS  
}

enum Job {
  DRAW_UPPER
  DRAW_LINING
  STITCH_UPPER
  STITCH_OUTSOLE
  STITCH_INSOLE
  LAST
}

enum Progress {
  INITIATED
  PENDING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
  FAILED
}

enum InvType {
  FACTORY
  STORAGE
  CONSIGNMENT
  STOREFRONT
}

model Role {
  id                Int             @id @default(autoincrement())
  name              String          @unique
  description       String?
  clearanceLevel    Int

  users             User[]
}

model User {
  id                Int             @id @default(autoincrement())
  email             String          @unique
  password          String
  firstName         String
  lastName          String?
  isActive          Boolean         @default(false)
  roleId            Int

  createdBy         Int?
  updatedBy         Int?
  approvedBy        Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  approvedAt        DateTime?  

  userInventories   InvToUser[]

  role              Role            @relation(fields: [roleId], references: [id])
  creator           User?           @relation("CreatedBy", fields: [createdBy], references: [id])
  createdUsers      User[]          @relation("CreatedBy")
  approver          User?           @relation("ApprovedBy", fields: [approvedBy], references: [id])
  approvedUsers     User[]          @relation("ApprovedBy")
}

model Color {
  id                Int             @id @default(autoincrement())
  name              String          @unique
  hexCode           String

  colorProducts     ColorToProduct[]
}

model ProductCategory {
  id                Int             @id @default(autoincrement())
  name              String          
  gender            Gender
  @@unique([name, gender])

  productGroups     ProductGroup[]
}

model ProductGroup {
  id                Int             @id @default(autoincrement())
  skuNumeric        String          @unique
  productCategoryId Int
  name              String?
  msrp              Int?

  createdAt         DateTime        @default(now())
  createdBy         Int
  updatedAt         DateTime        @updatedAt
  updatedBy         Int?

  products          Product[]
  laborCosts        LaborCost[]

  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id])
}

model Product {
  id                Int             @id @default(autoincrement())
  sku               String          @unique
  productGroupId    Int

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  productColors       ColorToProduct[]
  works               Work[]
  invProducts         InvToProduct[]
  // productsale         ProductToSale[]
  invTrfItems         InvTrfItem[]

  productGroup        ProductGroup    @relation(fields: [productGroupId], references: [id])
}

model ColorToProduct {
  productId         Int
  colorId           Int
  order             Int           

  @@id([productId, colorId, order])

  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  color             Color           @relation(fields: [colorId], references: [id])
}

model LaborCost {
  id                Int             @id @default(autoincrement())
  type              Job
  cost              Int
  productGroupId    Int             

  @@unique([productGroupId, type])

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tasks             Task[]
  productGroup      ProductGroup    @relation(fields: [productGroupId], references: [id], onDelete: Cascade)
}

model Artisan {
  id                Int             @id @default(autoincrement())
  firstName         String
  lastName          String?
  jobs              Job[]
  tasks             Task[]

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Work {
  id                Int             @id @default(autoincrement())
  date              DateTime
  orderNo           String          @unique
  productId         Int             
  workSizes         SizeToWork[]
  tasks             Task[]
  progress          Progress        @default(INITIATED)       
  note              String?          

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  product           Product         @relation(fields: [productId], references: [id])
  invTrf            InvTrf?
}

model Task {
  id                Int             @id @default(autoincrement())
  workId            Int
  type              Job
  artisanId         Int?
  doneAt            DateTime?
  laborCostId       Int
  @@unique([workId, type])

  work              Work            @relation(fields: [workId], references: [id], onDelete: Cascade)
  artisan           Artisan?        @relation(fields: [artisanId], references: [id], onDelete: Restrict)
  laborCost         LaborCost       @relation(fields: [laborCostId], references: [id])

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Size {
  id                Int             @id @default(autoincrement())
  eu                String                    
  us                String?         
  uk                String?         
  jp                String?
  gender            Gender

  sizeWorks           SizeToWork[]
  sizeInvProducts     InvProductToSize[]
  sizeInvTrfItems     InvTrfItemToSize[]
  sizeSaleItems       SaleItemToSize[]
  sizeInvTxs          InvTxToSize[]

  @@unique([eu, gender])
  @@unique([us, gender])
  @@unique([uk, gender])
}

model SizeToWork {
  @@id([workId, sizeId])
  workId            Int
  sizeId            Int

  quantity          Int

  work              Work            @relation(fields: [workId], references: [id], onDelete: Cascade)
  size              Size            @relation(fields: [sizeId], references: [id])
}

model Inventory {
  id                Int             @id @default(autoincrement())
  name              String          @unique
  address           String
  city              String
  province          String
  type              InvType

  invProducts       InvToProduct[]
  priceFormula      PriceFormula?
  invUsers          InvToUser[]

  fromTrfs          InvTrf[] @relation( "FromInventory")
  toTrfs            InvTrf[] @relation( "ToInventory")
  fromTrfItems      InvTrfItem[] @relation("FromInventory")
  toTrfItems        InvTrfItem[] @relation("ToInventory")
}

model InvToProduct {
  @@id([invId, productId])
  invId             Int
  productId         Int             

  invProductSizes   InvProductToSize[]
  discounts         Decimal[]       @db.Decimal(5,4)

  product           Product         @relation(fields: [productId], references: [id])
  inventory         Inventory       @relation(fields: [invId], references: [id])
  invTrfItems       InvTrfItem[]
  invProductSales   SaleItem[]
}

model InvProductToSize {
  @@id([invId, productId, sizeId])
  invId             Int
  productId         Int
  sizeId            Int

  quantity          Int

  invProduct        InvToProduct    @relation(fields: [invId, productId], references: [invId, productId], onDelete: Cascade)
  size              Size            @relation(fields: [sizeId], references: [id])
}

model InvTrfItem {
  id                Int             @id @default(autoincrement())
  invTrfId          Int?
  fromInvId         Int?
  toInvId           Int
  productId         Int
  invTrfItemSizes   InvTrfItemToSize[]
  progress          Progress        @default(PENDING)
  discounts         Decimal[]       @db.Decimal(5,4)

  invTrf            InvTrf?         @relation(fields: [invTrfId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  fromInv           Inventory?      @relation("FromInventory", fields: [fromInvId], references: [id])
  toInv             Inventory       @relation("ToInventory", fields: [toInvId], references: [id])
  invProduct        InvToProduct?   @relation(fields: [fromInvId, productId], references: [invId, productId])

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model InvTrf {
  id                Int             @id @default(autoincrement())
  trfNo             String          @unique
  fromInvId         Int?
  toInvId           Int
  trfDate           DateTime        @default(now())
  invTrfItems       InvTrfItem[]
  progress          Progress        @default(PENDING)
  workId            Int?            @unique           

  fromInv           Inventory?      @relation("FromInventory", fields: [fromInvId], references: [id])
  toInv             Inventory       @relation("ToInventory", fields: [toInvId], references: [id])
  work              Work?           @relation(fields: [workId], references: [id], onDelete: Restrict)

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  invTx             InvTx[]

  @@index([createdAt(sort: Desc)])
}

model InvTrfItemToSize {
  @@id([invTrfItemId, sizeId])
  invTrfItemId      Int
  sizeId            Int
  quantity          Int

  invTrfItem        InvTrfItem      @relation(fields: [invTrfItemId], references: [id], onDelete: Cascade)
  size              Size            @relation(fields: [sizeId], references: [id])
}

model InvTx {
  id                Int             @id @default(autoincrement())
  txNo              String
  invId             Int
  productId         Int
  invTxSizes        InvTxToSize[]
  type              TxType
  saleId            Int?            
  trfId             Int?            

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  sale              Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  invTrf            InvTrf?         @relation(fields: [trfId], references: [id], onDelete: SetNull)
  @@index([createdAt(sort: Desc)])
}

enum TxType {
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  PRODUCTION
  ADJUSTMENT
  REVERSION
}

model InvTxToSize {
  @@id([invTxId, sizeId])
  invTxId           Int
  sizeId            Int

  quantity          Int

  invTx             InvTx           @relation(fields: [invTxId], references: [id], onDelete: Cascade)
  size              Size            @relation(fields: [sizeId], references: [id])
}

model PriceFormula {
  id                Int             @id @default(autoincrement())
  multiplier        Decimal?        @db.Decimal(3,2)
  offset            Int?
  discounts         Decimal[]       @db.Decimal(5,4)
  invId             Int             @unique

  inventory         Inventory       @relation(fields: [invId], references: [id], onDelete: Cascade)
}

model Sale {
  id                Int             @id @default(autoincrement())
  saleNo            String          @unique
  date              DateTime
  saleItems         SaleItem[]

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  invTx             InvTx[]
  @@index([createdAt(sort: Desc)])
}

model SaleItem {
  id                Int             @id @default(autoincrement())
  saleId            Int
  invId             Int
  productId         Int
  saleItemSizes     SaleItemToSize[]

  sale              Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  invProduct        InvToProduct    @relation(fields: [productId, invId], references: [productId, invId])
}

model SaleItemToSize {
  @@id([saleItemId, sizeId])
  saleItemId        Int 
  sizeId            Int

  quantity          Int

  saleItem          SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  size              Size            @relation(fields: [sizeId], references: [id])
}

model InvToUser {
  @@id([invId, userId])
  invId             Int
  userId            Int

  inventory         Inventory       @relation(fields: [invId], references: [id])
  user              User            @relation(fields: [userId], references: [id])
}

