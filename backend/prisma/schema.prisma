// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  output = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MEN
  WOMEN
  KIDS  
}

enum Job {
  DRAW_UPPER
  DRAW_LINING
  STITCH_UPPER
  STITCH_OUTSOLE
  STITCH_INSOLE
  LAST
}

enum Progress {
  INITIATED
  PENDING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
  FAILED
}

enum InvType {
  FACTORY
  STORAGE
  CONSIGNMENT
  STOREFRONT
}

model Role {
  id                Int             @id @default(autoincrement())
  name              String          @unique
  description       String?
  clearanceLevel    Int

  users             User[]
}

model User {
  id                Int             @id @default(autoincrement())
  email             String          @unique
  password          String
  firstName         String
  lastName          String?
  isActive          Boolean         @default(false)
  roleId            Int

  createdBy         Int?
  updatedBy         Int?
  approvedBy        Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  approvedAt        DateTime?  

  role              Role            @relation(fields: [roleId], references: [id])
  creator           User?           @relation("CreatedBy", fields: [createdBy], references: [id])
  createdUsers      User[]          @relation("CreatedBy")
  approver          User?           @relation("ApprovedBy", fields: [approvedBy], references: [id])
  approvedUsers     User[]          @relation("ApprovedBy")
}

model Color {
  id                Int             @id @default(autoincrement())
  name              String          @unique
  hexCode           String

  colorProducts     ColorToProduct[]
}

model ProductCategory {
  id                Int             @id @default(autoincrement())
  name              String          
  gender            Gender
  @@unique([name, gender])

  productGroups     ProductGroup[]
}

model ProductGroup {
  id                Int             @id @default(autoincrement())
  skuNumeric        String          @unique
  productCategoryId Int
  name              String?

  createdAt         DateTime        @default(now())
  createdBy         Int
  updatedAt         DateTime        @updatedAt
  updatedBy         Int?

  products          Product[]
  laborCosts        LaborCost[]

  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id])
}

model Product {
  id                Int             @id @default(autoincrement())
  sku               String          @unique
  productGroupId    Int

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  productColors       ColorToProduct[]
  works               Work[]
  productInvs         InvToProduct[]
  // productsale         ProductToSale[]
  InvTrfItem          InvTrfItem[]

  productGroup        ProductGroup    @relation(fields: [productGroupId], references: [id])
}

model ColorToProduct {
  productId         Int
  colorId           Int
  order             Int           

  @@id([productId, colorId])

  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  color             Color           @relation(fields: [colorId], references: [id])
}

model LaborCost {
  id                Int             @id @default(autoincrement())
  type              Job
  cost              Int
  productGroupId    Int             

  @@unique([productGroupId, type])

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tasks             Task[]
  productGroup      ProductGroup    @relation(fields: [productGroupId], references: [id])
}

model Artisan {
  id                Int             @id @default(autoincrement())
  firstName         String
  lastName          String?
  jobs              Job[]
  tasks             Task[]

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Work {
  id                Int             @id @default(autoincrement())
  date              DateTime
  orderNo           String          @unique
  productId         Int             
  workSizes         SizeToWork[]
  tasks             Task[]
  progress          Progress        @default(INITIATED)       

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  product           Product         @relation(fields: [productId], references: [id])
  invTrfItem        InvTrfItem?
}

model Task {
  id                Int             @id @default(autoincrement())
  workId            Int
  type              Job
  artisanId         Int?
  doneAt            DateTime?
  laborCostId       Int
  @@unique([workId, type])

  work              Work            @relation(fields: [workId], references: [id], onDelete: Cascade)
  artisan           Artisan?        @relation(fields: [artisanId], references: [id], onDelete: Restrict)
  laborCost         LaborCost       @relation(fields: [laborCostId], references: [id])

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Size {
  id                Int             @id @default(autoincrement())
  eu                String                    
  us                String?         
  uk                String?         
  jp                String?
  gender            Gender

  sizeWorks           SizeToWork[]
  sizeInvProducts     InvProductToSize[]
  InvTrfItemToSize    InvTrfItemToSize[]
  // sizeSaleProducts    SaleProductToSize[]

  @@unique([eu, gender])
  @@unique([us, gender])
  @@unique([uk, gender])
}

model SizeToWork {
  @@id([workId, sizeId])
  workId            Int
  sizeId            Int

  quantity          Int

  work              Work            @relation(fields: [workId], references: [id], onDelete: Cascade)
  size              Size            @relation(fields: [sizeId], references: [id])
}

model Inventory {
  id                Int             @id @default(autoincrement())
  name              String          @unique
  address           String
  city              String
  province          String
  type              InvType

  invProducts       InvToProduct[]
  // invsale           Sale[]
  // salemen           Salesman[]  

  fromTrfs          InvTrf[] @relation( "FromInventory")
  toTrfs            InvTrf[] @relation( "ToInventory")
  fromTrfItems      InvTrfItem[] @relation("FromInventory")
  toTrfItems        InvTrfItem[] @relation("ToInventory")
}

model InvToProduct {
  @@id([invId, productId])
  invId             Int
  productId         Int             

  invProductSizes   InvProductToSize[]
  sellingPrice      Int             @default(0)
  discount          Decimal         @db.Decimal(3,2) @default(0.00)

  product           Product         @relation(fields: [productId], references: [id])
  inventory         Inventory       @relation(fields: [invId], references: [id])
  invTrfItems       InvTrfItem[]
}

model InvProductToSize {
  @@id([invId, productId, sizeId])
  invId             Int
  productId         Int
  sizeId            Int

  quantity          Int

  invProduct        InvToProduct    @relation(fields: [invId, productId], references: [invId, productId], onDelete: Cascade)
  size              Size            @relation(fields: [sizeId], references: [id])
}

model InvTrfItem {
  id                Int             @id @default(autoincrement())
  invTrfId          Int?
  fromInvId         Int?
  toInvId           Int
  productId         Int
  invTrfItemSizes   InvTrfItemToSize[]
  progress          Progress        @default(PENDING)
  workId            Int?            @unique

  invTrf            InvTrf?         @relation(fields: [invTrfId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  fromInv           Inventory?      @relation("FromInventory", fields: [fromInvId], references: [id])
  toInv             Inventory       @relation("ToInventory", fields: [toInvId], references: [id])
  invProduct        InvToProduct?   @relation(fields: [fromInvId, productId], references: [invId, productId])
  work              Work?           @relation(fields: [workId], references: [id], onDelete: Restrict)

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model InvTrf {
  id                Int             @id @default(autoincrement())
  trfNo             String          
  fromInvId         Int?
  toInvId           Int
  trfDate           DateTime        @default(now())
  invTrfItems       InvTrfItem[]
  progress          Progress        @default(PENDING)

  fromInv           Inventory?      @relation("FromInventory", fields: [fromInvId], references: [id])
  toInv             Inventory       @relation("ToInventory", fields: [toInvId], references: [id])

  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model InvTrfItemToSize {
  @@id([invTrfItemId, sizeId])
  invTrfItemId      Int
  sizeId            Int
  quantity          Int

  invTrfItem        InvTrfItem     @relation(fields: [invTrfItemId], references: [id], onDelete: Cascade)
  size              Size            @relation(fields: [sizeId], references: [id])
}

